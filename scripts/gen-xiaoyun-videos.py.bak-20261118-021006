VIDEOS = os.path.join(ASSETS, "videos")
STATE = os.path.join(ROOT, ".codebuddy", "xiaoyun-video-state.json")
os.makedirs(VIDEOS, exist_ok=True)
os.makedirs(os.path.dirname(STATE), exist_ok=True)

