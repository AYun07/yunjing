  "wx_tianyuan": {
    "nodes": [
      { "id": "wx_lingxiangdongtian", "n": "灵相洞天", "x": 16, "y": 22, "t": "relic", "d": 4, "rg": "天元神州", "desc": "无相圣宗所遗秘境，内有金露台、灵相宫，金烟可淬炼相性，造化神浆胜九品灵水奇光；宗主的枯荣相污染被奇阵镇压于深处，李洛在此炼火入相、凝成万相轮。", "c": "《万相之王》灵相洞天篇" },
      { "id": "wx_jiehebaoyu", "n": "界河宝域", "x": 42, "y": 16, "t": "relic", "d": 4, "rg": "天元神州", "desc": "界河域中的宝地，天地能量与异类遗藏交汇，是封侯之机的出处；四方强者云集争夺，李洛在此借宝域之机封侯，并踏上无双之路，为日后称王埋下根基。", "c": "《万相之王》界河宝域篇" },
      { "id": "wx_jieheyu", "n": "界河域", "x": 68, "y": 14, "t": "danger", "d": 4, "rg": "天元神州", "desc": "界河沿岸的辽阔战区，各大天王脉设卫驻守，异类越河则战；李洛归族后入龙牙卫历练，官至四统领，在此直面暗世界兵锋，也见证了界河灾变的爆发。", "c": "《万相之王》界河域篇" },
      { "id": "wx_tianjingta", "n": "天镜塔", "x": 90, "y": 20, "t": "relic", "d": 5, "rg": "天元神州", "desc": "学府联盟自无相圣宗继承的至宝，共三十六层，每层称一天域，核心为天王遗骸；塔中藏圣宗传承，万相种之秘亦在此曝光，入塔之试由天镜城的相力树传送阵开启。", "c": "《万相之王》天镜塔篇" },
      { "id": "wx_wuxiangyiji", "n": "无相圣宗遗迹", "x": 88, "y": 62, "t": "relic", "d": 4, "rg": "天元神州", "desc": "天元神州的上古宗门遗址，宗门总部已被放逐于重重虚空深处，只余残迹与零散传承；李太玄与澹台岚曾在此寻得万相种，孕期澹台岚被其融合，李洛因而三宫皆空。", "c": "《万相之王》无相圣宗遗迹篇" },
      { "id": "wx_shamodong", "n": "煞魔洞", "x": 66, "y": 78, "t": "danger", "d": 3, "rg": "天元神州", "desc": "李天王一脉龙牙脉的历练秘境，洞中煞气与魔物并存，闯洞成绩记于脉中碑上；李太玄年少时曾创下纪录，李洛归族认祖后将其刷新，脉中二十旗亦在此较技。", "c": "《万相之王》煞魔洞篇" },
      { "id": "wx_xiaochentian", "n": "小辰天", "x": 10, "y": 40, "t": "nature", "d": 4, "rg": "天元神州", "desc": "天元古学府征召弟子所赴的秘境，日月星辰之象错落，天材地宝与凶险并存；李洛与姜青娥在此重逢，姜青娥曾以圣银炎丹重创大恶魈，学府诸院天骄亦云集于此。", "c": "《万相之王》小辰天篇" },
      { "id": "wx_jinlongshan", "n": "金龙山", "x": 38, "y": 86, "t": "sect", "d": 4, "rg": "天元神州", "desc": "金龙宝行的真正核心所在，三姓七峰并立，吕、张、钱三脉各据一峰；山中有圣种与重宝，非金龙山嫡系不得入，吕清儿一脉的根基与天元录封侯榜皆由此维系。", "c": "《万相之王》金龙山篇" },
      { "id": "wx_longzuzudi", "n": "龙族祖地", "x": 88, "y": 90, "t": "nature", "d": 4, "rg": "天元神州", "desc": "精兽龙族的栖居之地，天龙即出自此族；李天王一脉的龙相与李钧的天王之力，皆与天龙有契约之渊源，天龙五脉的龙相传承亦可上溯至此。", "c": "《万相之王》龙族祖地篇" }
    ],
    "roads": [
