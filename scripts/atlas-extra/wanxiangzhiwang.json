  "wx_guiyi": {
    "nodes": [
      { "id": "wx_anshijie", "n": "暗世界", "x": 50, "y": 28, "t": "danger", "d": 5, "rg": "归一会", "desc": "人族世界的倒影，聚集人族恶念而诞生异类；内有鬼魊无数，最忌者七十二座大魊，堪比天王级势力。王侯战场、界河、暗窟皆与之相连，归一会欲融合异类寻真我，祸源即在此。", "c": "《万相之王》暗世界篇" },
      { "id": "wx_guiyu", "n": "鬼魊", "x": 18, "y": 24, "t": "danger", "d": 4, "rg": "归一会", "desc": "暗世界中异类盘踞的巢穴，大小不一，小者如洞窟，大者自成一方天地；魔王所居之魊往往藏有重宝，入暗世界清剿者最常在此遭遇异类，恶念侵蚀亦以此处最烈。", "c": "《万相之王》鬼魊篇" },
      { "id": "wx_dayu", "n": "大魊", "x": 84, "y": 18, "t": "danger", "d": 5, "rg": "归一会", "desc": "暗世界中最顶尖的异类巢穴，共七十二座，每一座都相当于十大神州中的天王级势力，大魊之主多为魔王；归一会所引以为恃的异类根基，正藏在这些大魊深处。", "c": "《万相之王》七十二大魊篇" },
      { "id": "wx_wanghouzhanchang", "n": "王侯战场", "x": 62, "y": 8, "t": "danger", "d": 5, "rg": "归一会", "desc": "十大神州与暗世界相连之地，唯封侯以上可入，生还者十不存一；各方以黑白生死签定入选者，黑签即入战场。李太玄与澹台岚因宫渊设计抽中黑签同赴此地，自此失踪。", "c": "《万相之王》王侯战场篇" },
      { "id": "wx_shenyuan", "n": "天渊", "x": 92, "y": 62, "t": "nature", "d": 5, "rg": "归一会", "desc": "天王镇守之地，界河尽头的深渊；李、秦、赵、朱四位天王皆驻于此，等闲不行走神州，天渊一破则神州倾覆，是人族抵御暗世界的最后屏障，异类越界终须在此受阻。", "c": "《万相之王》天渊篇" },
      { "id": "wx_jiehe", "n": "界河", "x": 14, "y": 52, "t": "nature", "d": 4, "rg": "归一会", "desc": "人族世界与暗世界之间的巨河，河上烽火终年不熄；十大神州各以天王脉之兵镇守，天龙五卫、黑水卫、万兽卫、吞天卫皆驻于此，异类越河则战，界河灾变亦由此蔓延。", "c": "《万相之王》界河篇" },
      { "id": "wx_wurandai", "n": "污染带", "x": 50, "y": 84, "t": "danger", "d": 4, "rg": "归一会", "desc": "大夏异灾后横贯国土的恶念污染地带，将大夏生生割为南北两域；庞千源的压制只能维持数年，污染带一旦扩散，大夏便无净土，异类与恶念正由此不断渗入人族腹地。", "c": "《万相之王》大夏异灾篇" },
      { "id": "wx_daxiabeiyu", "n": "大夏北域", "x": 20, "y": 86, "t": "sect", "d": 4, "rg": "归一会", "desc": "大夏异灾后恶念污染带以北的疆土，宫渊在此自立北域之王并投靠归一会，得祝青火、司擎等强者支持，封玄宸为国师，成为归一会插入人族腹地的一方据点。", "c": "《万相之王》大夏北域篇" },
      { "id": "wx_hongshajun", "n": "红砂郡", "x": 80, "y": 88, "t": "danger", "d": 4, "rg": "归一会", "desc": "黑风帝国的一郡，被暗窟破裂引发的异灾污染；圣杯战混级赛的净化任务所在地，李洛一行随学府精英深入其腹地，在此对抗大天灾级异类，异类之祸由此显露一角。", "c": "《万相之王》圣杯战·红砂郡篇" }
    ],
