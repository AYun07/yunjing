{
  "wx_daxia": {
    "nodes": [
      { "id": "wx_tianshujun", "n": "天蜀郡", "x": 14, "y": 42, "t": "city", "d": 2, "rg": "大夏国", "desc": "大夏国南部大郡，首城南风城，李洛故乡；洛岚府自此发家，郡内另有宋、贝、蒂法三大家与总督府，南风学府为郡内第一学府，灵水奇光之祭亦在此角力。", "c": "《万相之王》天蜀郡篇" },
      { "id": "wx_nanfengcheng", "n": "南风城", "x": 10, "y": 18, "t": "city", "d": 1, "rg": "大夏国", "desc": "天蜀郡首城，李洛出生与成长之地；城中有南风学府、洛岚府老宅、金龙宝行分行与清风楼，城门口的青石荣誉墙刻着历代天骄之名，姜青娥的水晶光影高悬其上。", "c": "《万相之王》南风城篇" },
      { "id": "wx_nanfengxuefu", "n": "南风学府", "x": 36, "y": 12, "t": "sect", "d": 2, "rg": "大夏国", "desc": "天蜀郡第一学府，分一院至四院，一院为郡内最卓异的少年所聚；训练场、相力树与荣誉墙皆在府中。李洛开相宫现三座空相宫，自一院贬入二院，在此看遍冷眼。", "c": "《万相之王》南风学府篇" },
      { "id": "wx_luolanlaozhai", "n": "洛岚府老宅", "x": 32, "y": 88, "t": "relic", "d": 1, "rg": "大夏国", "desc": "洛岚府在南风城的祖宅，李洛与姜青娥幼年居所；府主李太玄、澹台岚失踪后，此处仍留有不少旧人与产业账目，蔡薇曾在此主持天蜀郡事务，是洛岚府在南风城的根基。", "c": "《万相之王》洛岚府老宅篇" },
      { "id": "wx_daxiawangting", "n": "大夏王庭宫城", "x": 90, "y": 56, "t": "city", "d": 3, "rg": "大夏国", "desc": "大夏城中的宫家宫城，护国奇阵的核心所在；先帝宫轩在此驾崩，少帝宫景曜在此登基，摄政王宫渊亦在此发难，酿成王庭之变，府祭时澹台岚的预留幻影曾击伤宫渊。", "c": "《万相之王》王庭之变篇" },
      { "id": "wx_shengxuananku", "n": "圣玄星暗窟", "x": 64, "y": 20, "t": "danger", "d": 4, "rg": "大夏国", "desc": "圣玄星学府所镇守的暗窟，为暗世界与人族的连接之地；窟中恶念弥漫，异类与精兽出没，学府弟子须接令入内清剿。李洛第一次暗窟任务即在此，以驱虎吞狼之计脱身。", "c": "《万相之王》圣玄星暗窟篇" },
      { "id": "wx_tianshufangshi", "n": "天蜀郡坊市", "x": 40, "y": 34, "t": "city", "d": 2, "rg": "大夏国", "desc": "南风城的坊市，灵水奇光、相具、药材与消息皆在此流通；淬相铺、金龙宝行分行与各商会盘踞其间，是洛岚府与宋、贝、蒂法三大家角力的明面战场。", "c": "《万相之王》天蜀郡坊市篇" },
      { "id": "wx_beqiujun", "n": "北丘郡", "x": 88, "y": 16, "t": "nature", "d": 2, "rg": "大夏国", "desc": "大夏国一郡，郡中莫家掌墨水屋，与宋家松子屋结盟参与天蜀郡灵水奇光之祭；莫凌即出自此家，郡中相具与灵水生意同天蜀郡诸家往来密切。", "c": "《万相之王》北丘郡篇" },
      { "id": "wx_daxiananyu", "n": "大夏南域", "x": 60, "y": 86, "t": "nature", "d": 3, "rg": "大夏国", "desc": "大夏异灾后污染带以南的疆土，宫鸾羽率王庭残部退守于此，建南域王庭，数年间统合势力抵御异类与北域进攻；后与李洛北伐收复大夏城，重归一统。", "c": "《万相之王》大夏南域篇" }
    ],
