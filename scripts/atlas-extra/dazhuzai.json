{
  "d_beiling": {
    "nodes": [
      { "id": "d_muyu", "n": "牧域", "x": 26, "y": 86, "t": "city", "d": 2, "rg": "北灵境", "desc": "北灵境九大域之一，域主牧锋，少主牧尘。牧尘打通灵脉、击杀柳域之主柳惊山后，牧域取代柳域成为北灵境第一大域，并以此为根基组建北灵盟。", "c": "《大主宰》北灵境篇" },
      { "id": "d_liuyu", "n": "柳域", "x": 10, "y": 52, "t": "city", "d": 3, "rg": "北灵境", "desc": "北灵境九大域之一，域主柳惊山，大少主柳慕白、小少主柳阳。柳域曾为北灵境第一大域，柳惊山被牧尘借九幽雀之力越阶击杀后元气大伤，地位由牧域取代。", "c": "《大主宰》北灵境篇" },
      { "id": "d_tangyu", "n": "唐域", "x": 34, "y": 40, "t": "city", "d": 2, "rg": "北灵境", "desc": "北灵境九大域之一，域主唐山，大小姐唐芊儿。唐域素来与牧域交好，牧尘少年时多受唐家照拂，唐芊儿也因此成为他最亲近的同辈之一，后入万凰灵院。", "c": "《大主宰》北灵境篇" },
      { "id": "d_hongyu", "n": "红域", "x": 58, "y": 66, "t": "city", "d": 2, "rg": "北灵境", "desc": "北灵境九大域之一，域主红灵，大小姐红绫。红域与牧域、唐域往来密切，红绫自幼与牧尘相识；五大院选拔中她与唐芊儿战平，一同进了万凰灵院。", "c": "《大主宰》北灵境篇" },
      { "id": "d_lieyu", "n": "烈域", "x": 20, "y": 26, "t": "city", "d": 3, "rg": "北灵境", "desc": "北灵境九大域之一，域主烈炎。烈域尚武，域中子弟多修火性灵力，在九域合纵连横中自成一脉；牧锋组建北灵盟后，烈域归于盟约之下。", "c": "《大主宰》北灵境篇" },
      { "id": "d_luoyu", "n": "罗域", "x": 44, "y": 18, "t": "city", "d": 2, "rg": "北灵境", "desc": "北灵境九大域之一，域主罗宣。罗域地处北灵境一隅，实力在九域中处于中游，不争锋芒；牧锋组建北灵盟后，罗域奉盟约行事，北灵境九域格局自此定于一盟。", "c": "《大主宰》北灵境篇" },
      { "id": "d_beilingzhiyuan", "n": "北灵之原", "x": 86, "y": 60, "t": "nature", "d": 4, "rg": "北灵境", "desc": "北灵境闻名的险地，遍布凶猛灵兽，也盛产珍稀材料与灵药，常年有探险队与佣兵团进出。血屠佣兵团即在此一带活动，牧尘与洛璃曾在此并肩历险。", "c": "《大主宰》北灵境篇" },
      { "id": "d_heimingyuan", "n": "黑冥渊", "x": 88, "y": 86, "t": "danger", "d": 5, "rg": "北灵境", "desc": "位于北灵境偏南的偏僻凶险之所，人迹罕至、极端缺少人气。北灵境修士多视之为禁地，寻常队伍不敢深入，渊中气息阴寒，是境内少有人愿踏足的死地。", "c": "《大主宰》北灵境篇" },
      { "id": "d_mangyinshan", "n": "邙阴山", "x": 8, "y": 88, "t": "danger", "d": 4, "rg": "北灵境", "desc": "坐落邙阴山脉，与牧域西边接壤，实力堪称北灵境黑道最强，暗中一直与柳域有联系。后被牧域联合九龙寨所灭，北灵境黑道格局由此改写。", "c": "《大主宰》北灵境篇" }
    ],
