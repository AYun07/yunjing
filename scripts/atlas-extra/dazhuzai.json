  "d_daluo": {
    "nodes": [
      { "id": "d_daluotian_sky", "n": "大罗天", "x": 36, "y": 78, "t": "city", "d": 4, "rg": "大罗天域", "desc": "大罗天域的总部，一片漂浮在空中的小型大陆，有璀璨光罩笼罩。其上殿宇无数，天际流光掠过，阵势铺天盖地，是整座天域权力的中枢。", "c": "《大主宰》大罗天域篇" },
      { "id": "d_jinchifeng", "n": "金池峰", "x": 56, "y": 82, "t": "nature", "d": 3, "rg": "大罗天域", "desc": "大罗天内的山峰，峰上便是大罗金池。金池之水能令至尊法身更为完美，是整座大罗天域最珍贵的修炼资源之一，峰上守卫森严，等闲不得靠近。", "c": "《大主宰》大罗天域篇" },
      { "id": "d_daluojinchi", "n": "大罗金池", "x": 74, "y": 86, "t": "relic", "d": 3, "rg": "大罗天域", "desc": "大罗天金池峰上的神异池水，拥有令至尊法身更为完美的力量。牧尘在此淬得大罗金身，并于此地遇见大罗域主曼荼罗；池水千年不涸，天域上下视若命脉。", "c": "《大主宰》大罗天域篇" },
      { "id": "d_daluoyanchi", "n": "大罗炎池", "x": 88, "y": 64, "t": "relic", "d": 4, "rg": "大罗天域", "desc": "大罗天域中的炎属性修炼池。牧尘在此修炼，击杀受伤的炎龙蝎，借幽冥心魔雷取得九滴上古炎龙精血，修为直入三品至尊；池底炎气凝而不散，非修火者不敢久留。", "c": "《大主宰》大罗天域篇" },
      { "id": "d_leimoyuan", "n": "雷魔渊", "x": 12, "y": 34, "t": "danger", "d": 5, "rg": "大罗天域", "desc": "雷魔宗山门所在的深渊，雷魔宗覆灭后为牧尘所探。渊中藏有幽冥心魔雷，牧尘将其炼化，雷道修为大进；深渊雷气终年不散，寻常修士触之即伤。", "c": "《大主宰》大罗天域篇" },
      { "id": "d_siwangyiji", "n": "死亡遗迹", "x": 10, "y": 88, "t": "danger", "d": 5, "rg": "大罗天域", "desc": "天罗大陆北界的一处凶险遗迹，牧尘与九幽曾率裂山王、血鹰王、灵剑王、洪崖王等进入探索。玄天殿萧天亦在此与牧尘交手，被断一臂。", "c": "《大主宰》大罗天域篇" },
      { "id": "d_jiuyoujie", "n": "九幽界", "x": 44, "y": 20, "t": "sect", "d": 4, "rg": "大罗天域", "desc": "九幽雀族所居之地，与神兽之原相通，族中多带上古不死鸟血脉。牧尘在此击败九幽雀族的姜岈与秦玄，取得进入神兽之原的名额；界中雀羽蔽日，血脉威压极重。", "c": "《大主宰》大罗天域篇" }
    ],
