  "d_beicang": {
    "nodes": [
      { "id": "d_lingjuedian", "n": "灵诀殿", "x": 12, "y": 42, "t": "relic", "d": 3, "rg": "北苍大陆", "desc": "北苍灵院存放与挑选灵诀的殿阁，殿中有镇守者与守阵，学员须破阵方能取诀。牧尘曾在此被体内神秘黑纸牵引，得到四神星宿经；殿外守阵森严，寻常学员连门都难以踏入。", "c": "《大主宰》北苍灵院篇" },
      { "id": "d_lingzhidian", "n": "灵值殿", "x": 32, "y": 72, "t": "city", "d": 2, "rg": "北苍大陆", "desc": "北苍灵院中供学员交易天材地宝、功法绝技的殿阁，通用货币为灵值。神级灵诀、神兽精血亦有出售，部分货物出自学员寄售，院中消息也多在此流转。", "c": "《大主宰》北苍灵院篇" },
      { "id": "d_beicangta", "n": "北苍塔", "x": 52, "y": 80, "t": "relic", "d": 4, "rg": "北苍大陆", "desc": "北苍界深处的试炼之塔，塔内关卡层层递进，凶险非常。通过北苍塔者方能抵达北苍殿，接受北苍灵院的入院考验，是无数报考少年折戟之地。", "c": "《大主宰》北苍灵院篇" },
      { "id": "d_beicangjie", "n": "北苍界", "x": 68, "y": 68, "t": "nature", "d": 4, "rg": "北苍大陆", "desc": "北苍灵院专门用来考验学员的秘境，共有四个，每个都极辽阔，遍布凶地与强横灵兽。每界有上百接引台，中心为北苍殿，殿中传送灵阵可直通灵院。", "c": "《大主宰》北苍灵院篇" },
      { "id": "d_leiyu", "n": "雷域", "x": 88, "y": 58, "t": "nature", "d": 4, "rg": "北苍大陆", "desc": "北苍灵院开辟的修炼之地，拥有无尽天雷，可淬炼灵力、强化肉身。神魄境以上学员方可进入，修炼之余能凝炼天雷珠换取灵值；雷域共九层，第九层有北溟龙鲲坐镇。", "c": "《大主宰》北苍灵院篇" },
      { "id": "d_shengling_shan", "n": "圣灵山", "x": 94, "y": 26, "t": "relic", "d": 5, "rg": "北苍大陆", "desc": "北苍大陆的一处上古秘境，山中有九天梯，登顶者可受洗礼之力。牧尘在此与悬赏榜第一的魔刑天死战并将其击杀，夺得九天梯第一层之位。", "c": "《大主宰》北苍大陆篇" },
      { "id": "d_jiutianti", "n": "九天梯", "x": 82, "y": 14, "t": "relic", "d": 4, "rg": "北苍大陆", "desc": "圣灵山中的登顶阶梯，层级越高所得的洗礼之力越强。牧尘为争第一层的位置与魔刑天死战，胜后登顶受洗礼，修为大进，此后九天梯成为天骄争锋的象征。", "c": "《大主宰》北苍大陆篇" },
      { "id": "d_beilingshan", "n": "北灵山", "x": 36, "y": 20, "t": "nature", "d": 4, "rg": "北苍大陆", "desc": "北苍灵院内一座万丈高大的巍峨山岳，山中灵兽极多，山顶处有数头天阶灵兽盘踞，是院中学员历练与猎兽的常去之处，深入者若不知进退往往有去无回。", "c": "《大主宰》北苍灵院篇" },
      { "id": "d_lingguangjie", "n": "灵光界", "x": 10, "y": 10, "t": "relic", "d": 3, "rg": "北苍大陆", "desc": "北苍灵院的一处试炼秘境，院中学员入内历练。牧尘曾与洛璃在灵光界中联手击杀新生灵王，以此在院中扬名，洛神会之名也自此渐起。", "c": "《大主宰》北苍灵院篇" }
    ],
