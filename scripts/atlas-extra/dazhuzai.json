  "d_tianluo": {
    "nodes": [
      { "id": "d_xitianzhancheng", "n": "西天战城", "x": 26, "y": 86, "t": "city", "d": 4, "rg": "天罗大陆", "desc": "西天大陆的核心圣城，被誉为不可侵犯之地，是整座西天大陆的焦点。大陆之子争夺战便在此城举办，西天战皇在此召见四大圣子；城头战旗遮天，非战殿召见者不得入内。", "c": "《大主宰》西天篇" },
      { "id": "d_wangucheng", "n": "万古城", "x": 6, "y": 52, "t": "city", "d": 4, "rg": "天罗大陆", "desc": "摩诃古族掌握的古城，万古不朽身的争夺之战万古会在此展开。摩诃天与黑天、黑地曾在此城联手对付牧尘，城中古阵与传承皆归古族所有。", "c": "《大主宰》五大古族篇" },
      { "id": "d_longfenggucheng", "n": "龙凤古城", "x": 12, "y": 32, "t": "city", "d": 4, "rg": "天罗大陆", "desc": "龙凤阁固守的古城。龙凤阁只守此城，不向外拓展疆域，树敌极少却无人愿轻易得罪，古城因此成为天罗大陆一方超然之地；阁中龙凤传承只传嫡系，外人求一见亦难。", "c": "《大主宰》天罗大陆篇" },
      { "id": "d_longfengtian", "n": "龙凤天", "x": 32, "y": 20, "t": "nature", "d": 4, "rg": "天罗大陆", "desc": "大千世界的一处秘境，与龙凤阁、龙凤古城渊源极深。牧尘在此结识彩潇，入龙凤阁得龙凤金甲与龙凤真经，修成可与天榜神兽龙凰媲美的龙凤体。", "c": "《大主宰》天罗大陆篇" },
      { "id": "d_shangzhidalu", "n": "商之大陆", "x": 48, "y": 88, "t": "city", "d": 3, "rg": "天罗大陆", "desc": "以商业为主调的大陆，四方宝物汇聚于此，经由各大拍卖场流转。此地口号是只要拥有足够至尊灵液，就能买到任何想要的东西；牧尘在此结识林静、结怨柳冥。", "c": "《大主宰》天罗大陆篇" },
      { "id": "d_shenshouzhiyuan", "n": "神兽之原", "x": 72, "y": 64, "t": "nature", "d": 4, "rg": "天罗大陆", "desc": "大千世界神兽族群聚居的辽阔原野，内有万兽墓、神墓园、远古炼体塔、多宝兽陨落之地等凶险秘境，是牧尘淬炼龙凤体、夺取不死鸟精血之地。", "c": "《大主宰》神兽之原篇" },
      { "id": "d_wanshoumu", "n": "万兽墓", "x": 88, "y": 80, "t": "danger", "d": 5, "rg": "天罗大陆", "desc": "神兽之原中的凶险墓地，埋葬无数强大灵兽。牧尘在此秒杀三位七品至尊、重伤金擎天，以血统与战力震慑诸族天骄；墓地深处灵兽残念不散，寻常人踏入即被吞噬。", "c": "《大主宰》神兽之原篇" },
      { "id": "d_liantita", "n": "炼体塔", "x": 58, "y": 80, "t": "relic", "d": 4, "rg": "天罗大陆", "desc": "神兽之原中的远古炼体塔，共分多层，以肉身硬撼塔中考验。牧尘在第四层凭肉身打爆九盏灯，第五层脱身后龙凤真经修至第二层，并领悟舍身魔拳。", "c": "《大主宰》神兽之原篇" },
      { "id": "d_shenmuyuan", "n": "神墓园", "x": 92, "y": 56, "t": "danger", "d": 5, "rg": "天罗大陆", "desc": "神兽之原中争夺上古不死鸟精血的禁地。牧尘在此击败寒凰族白冥，并以重伤之躯催动残存天兽军战意，抹杀脱逃的域外邪族王者意念。", "c": "《大主宰》神兽之原篇" }
    ],
